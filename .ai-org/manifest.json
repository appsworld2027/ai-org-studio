{
  "organization": "appsworld",
  "adapterVersion": "2",
  "source": "appsworld2027/parent-plus-ai-org",
  "protectedActions": [
    "production",
    "destructive",
    "paid",
    "credentials",
    "legal-privacy"
  ],
  "handbook": {
    "repo": "appsworld2027/parent-plus-ai-org",
    "ref": "main",
    "entry": "AGENTS.md"
  },
  "product": {
    "name": "AI Org Studio",
    "docsFolder": "docs/product"
  },
  "commands": {
    "check": "npm test"
  },
  "governance": {
    "autoMerge": false,
    "founders": [
      "appsworld2027"
    ],
    "approvalRule": "Founder approval required before merge or deployment."
  },
  "executionPolicy": {
    "enabled": true,
    "allowedEngines": [
      "free"
    ],
    "allowPaidFallback": false,
    "allowProductionDeployment": false,
    "provider": "groq",
    "models": {
      "builder": "groq/openai/gpt-oss-120b",
      "reviewer": "groq/qwen/qwen3.8-27b"
    },
    "requirePrivateRepositoriesForConfidentialCode": true
  },
  "memory": {
    "folder": "docs/ai-memory",
    "rule": "Preserve validated handovers and reviewed memory."
  },
  "allowedProductRepositories": [
    "appsworld2027/Parent-plus-"
  ],
  "allowedPublicCodeRepositories": [
    "appsworld2027/Parent-plus-"
  ],
  "inheritProductExecutionPolicyFor": [
    "appsworld2027/Parent-plus-"
  ],
  "publicCodeDataPolicy": {
    "scope": "public-source-code-and-synthetic-test-data-only",
    "prohibitSecrets": true,
    "prohibitProductionCredentials": true,
    "prohibitCustomerPersonalData": true,
    "prohibitChildPersonalData": true
  }
}
