#!/usr/bin/env bash
# Test-only mapping of the private fixture transport to an isolated local bare repo.
set -euo pipefail
fixture="https://github.com/example/studio-private-fixture.git"
if [[ "${1:-}" == "-C" && "${2:-}" == "${FAKE_GARAGE_ROOT:-}" && ( "${3:-}" == "push" || "${3:-}" == "pull" ) ]]; then
  root="$2"; shift 2
  # For transport only; remote get-url still returns the original HTTPS URL.
  GIT_ALLOW_PROTOCOL=file exec "${REAL_GIT:?}" -C "$root" -c "url.${FAKE_GARAGE_REMOTE:?}.insteadOf=$fixture" "$@"
fi
for arg in "$@"; do
  if [[ "$arg" == "$fixture" ]]; then echo "Unexpected Git fixture transport" >&2; exit 1; fi
done
exec "${REAL_GIT:?}" "$@"
