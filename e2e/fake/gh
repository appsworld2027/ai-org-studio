#!/usr/bin/env bash
# Only the synthetic Garage and Parent Plus fixtures are verified private.
if [ "$*" = "api --hostname github.com repos/example/studio-private-fixture --jq {full_name,visibility}" ]; then
  echo '{"full_name":"example/studio-private-fixture","visibility":"private"}'
  exit 0
fi
if [ "$*" = "api --hostname github.com repos/example/studio-private-fixture/actions/workflows?per_page=100 --jq {total_count,workflows:[.workflows[]|{name,path,state}]}" ]; then
  echo '{"total_count":0,"workflows":[]}'
  exit 0
fi
# Stand-in for the GitHub CLI during tests: serves the 23-Nov Parent Plus snapshot.
F="$(cd "$(dirname "$0")/../../test/fixtures" && pwd)"
[ -f "${FAKE_GH_FAIL:-/nonexistent}" ] && { echo "HTTP 503: GitHub unavailable" >&2; exit 1; }
if [ "$1 $2" = "repo view" ]; then
  case "$3" in acme/Demo-App) echo '{"name":"Demo-App","nameWithOwner":"acme/Demo-App","homepageUrl":"","defaultBranchRef":{"name":"main"}}'; exit 0;; *) echo "GraphQL: Could not resolve to a Repository" >&2; exit 1;; esac
fi
if [ "$1 $2" = "repo clone" ]; then
  d="$4"; mkdir -p "$d/prototypes" && cd "$d" && git init -q -b main && echo '<h1>demo</h1>' > prototypes/home.html && git add -A && git -c user.email=t@t -c user.name=t commit -qm init && exit 0
fi
if [ "$1 $2 $3" = "run download 1201" ] && [ "$5" = "appsworld2027/Parent-plus-" ] && [ "$7" = "ai-org-usage-1" ]; then
  node -e 'const fs=require("fs");fs.writeFileSync(process.argv[1],JSON.stringify({version:1,at:Date.now(),rows:[{model:"fixture/worker-model",role:"Maya",input:32,output:7}]}))' "$9/ai-org-usage.json"
  exit $?
fi
if [ "$1" = "api" ] && [ "$2" = "repos/appsworld2027/Parent-plus-" ]; then
  echo '{"full_name":"appsworld2027/Parent-plus-","private":true}'
  exit 0
fi
[ "$1" = api ] || { echo "fake gh: unsupported $*" >&2; exit 2; }
# Idempotent Parent Plus issue adapter fixture used by Founder Inbox browser E2E.
if [ "$2" = "--paginate" ] && [ "$3" = "--slurp" ] && [[ "$4" == repos/appsworld2027/Parent-plus-/issues* ]]; then
  node -e 'const fs=require("fs"),p=process.argv[1];let a=[];try{a=JSON.parse(fs.readFileSync(p,"utf8"))}catch{};console.log(JSON.stringify([a]))' "${STUDIO_HOME}/fake-dispatched-issues.json"
  exit 0
fi
if [ "$2" = "--method" ] && [ "$3" = "POST" ] && [ "$4" = "repos/appsworld2027/Parent-plus-/issues" ]; then
  shift 4
  title=""; body=""
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "-f" ] && [ -n "${2:-}" ]; then
      case "$2" in
        title=*) title="${2#title=}" ;;
        body=*) body="${2#body=}" ;;
      esac
      shift 2
    else
      shift
    fi
  done
  node - "${STUDIO_HOME}/fake-dispatched-issues.json" "$title" "$body" <<'NODE'
const fs = require("fs");
const [file, title, body] = process.argv.slice(2);
let issues = [];
try { issues = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}
const number = 500 + issues.length;
const issue = {
  number, state: "open", title, body,
  html_url: `https://github.com/appsworld2027/Parent-plus-/issues/${number}`,
  labels: [{ name: "ai:discovery" }]
};
issues.push(issue);
fs.writeFileSync(file, JSON.stringify(issues, null, 2));
console.log(JSON.stringify(issue));
NODE
  exit $?
fi
case "$2" in
  */issues\?state=open*) cat "$F/issues.json";;
  */pulls\?state=open*) cat "$F/pulls.json";;
  repos/appsworld2027/Parent-plus-/actions/artifacts*) echo '{"artifacts":[{"name":"ai-org-usage-1","size_in_bytes":100,"workflow_run":{"id":1201}}]}';;
  */actions/artifacts*) echo '{"artifacts":[]}';;
  */actions/runs*) cat "$F/runs.json";;
  */issues/comments*) cat "$F/comments.json";;
  */contents/docs/product/BACKLOG.md) cat "$F/backlog.json";;
  */contents/org/agents\?ref=*) node -e 'const fs=require("fs"),d=process.argv[1];console.log(JSON.stringify(fs.readdirSync(d).map(n=>({name:n,path:"org/agents/"+n}))))' "$F/agents";;
  */contents/org/agents/*.md\?ref=*) f="${2##*/org/agents/}"; f="${f%%\?*}"; node -e 'const fs=require("fs");console.log(JSON.stringify({content:fs.readFileSync(process.argv[1]).toString("base64")}))' "$F/agents/$f";;
  */deployments*) echo "[]";;
  *) echo "fake gh: no fixture for $2" >&2; exit 1;;
esac
